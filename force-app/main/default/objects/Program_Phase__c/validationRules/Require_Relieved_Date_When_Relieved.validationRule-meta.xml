<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Relieved_Date_When_Relieved</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Assignment_Status__c, &quot;Relieved&quot;) &amp;&amp; ISBLANK(Relieved_Date__c)</errorConditionFormula>
    <errorDisplayField>Relieved_Date__c</errorDisplayField>
    <errorMessage>Please enter a Relieved Date when marking the trainer assignment as Relieved.</errorMessage>
</ValidationRule>
